# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/compliance_engine
DATABASE_POOL_MIN_SIZE=5
DATABASE_POOL_MAX_SIZE=20

# Platform Admin Initialization
# Set these during initial deployment to create the first platform admin
INITIAL_PLATFORM_ADMIN_EMAIL=admin@compliance-engine.com
INITIAL_PLATFORM_ADMIN_NAME="Platform Administrator"

# API Configuration
API_PREFIX=/api/v1
ENVIRONMENT=development
VERSION=1.0.0

# Security
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Logging
LOG_LEVEL=INFO

# Optional: Integration with external auth providers
# AUTH_PROVIDER=okta
# AUTH_PROVIDER_CLIENT_ID=your_client_id
# AUTH_PROVIDER_CLIENT_SECRET=your_client_secret